<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="condominioPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.edu.catolica.ucb.poo.persistencia.LocalDateConverter</class>
        <class>br.edu.catolica.ucb.poo.modelo.Pessoa</class>
        <class>br.edu.catolica.ucb.poo.modelo.Morador</class>
        <class>br.edu.catolica.ucb.poo.modelo.Funcionario</class>
        <class>br.edu.catolica.ucb.poo.modelo.Unidade</class>
        <class>br.edu.catolica.ucb.poo.modelo.Taxa</class>
        <class>br.edu.catolica.ucb.poo.modelo.AreaComum</class>
        <class>br.edu.catolica.ucb.poo.modelo.Reserva</class>
        <class>br.edu.catolica.ucb.poo.modelo.Aviso</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:condominio.db"/>
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <!-- cria/atualiza as tabelas automaticamente a partir das entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
